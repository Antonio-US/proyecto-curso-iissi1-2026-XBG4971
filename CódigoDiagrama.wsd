@startuml

skinparam linetype ortho
skinparam Nodesep 110
caption Vista Base

' Tipos Enumerados

enum RolUsuario
	RolUsuario : Socio
	RolUsuario : Administrador
	RolUsuario : Presidente
	RolUsuario : Técnico

' Entidades y sus Atributos
entity Usuario
	Usuario : nombreUsuario
	Usuario : contraseña
	Usuario : fechaAntiguedad
	Usuario : rol:RolUsuario
	Usuario : nombre
	Usuario : apellidos
	Usuario : numSocio
	Usuario : teléfono
	Usuario : dirección
	Usuario : correo

entity ListaPermisos
	ListaPermisos : fechaCambio
	ListaPermisos : descarga
	ListaPermisos : subida
	ListaPermisos : eliminación
	ListaPermisos : administración
	ListaPermisos : verificación
	ListaPermisos : registro
	ListaPermisos : acceso

entity Archivo
	Archivo : fechaSubida
	Archivo : formato
	Archivo : direcciónArchivo
	Archivo : tamaño
	Archivo : numDescargas
	Archivo : verificado 


entity Asignatura
	Asignatura : nombreAsignatura
	Asignatura : titulación
	Asignatura : añoCarrera

entity Valoración
	Valoración : puntuación
	Valoración : reseña
	Valoración : respuestaAdministrador [0..1]

entity Petición
	Petición : Asunto
	Petición : mensajeUsuario
	Petición : formato
	Petición : leido
	Petición : respuestaAdministrador [0..1]
	Petición : cumplida

entity Mentoría
    Mentoría : fechaInicio
	Mentoría : fechaFin

entity Rechazo
	Rechazo : razón

Usuario "1" *--u- "1" ListaPermisos : cuentaCon >
Usuario "*" -d- "*" Usuario : edita >

Usuario "*" -u- "*" ListaPermisos : modifica >
Usuario "0..1" -- "*" Archivo : sube >
Usuario "0..2\n(administrador)" --- "*" Archivo : revisa >
(Usuario,Archivo) .. Rechazo
Usuario "1" -- "*" Archivo : edita >
Usuario "*" -- "*" Archivo : descarga >
(Usuario, Archivo) .. Valoración
Usuario "1\n(administrador)" -l- "*" Valoración : responde >

Archivo "*" -- "1" Asignatura : perteneceA >


Usuario "*\n(administrador)" -- "*" Petición : cambia >
Usuario "1" -r- "*" Petición : realiza >
Petición "*" -- "1" Asignatura : solicitaSobre >
Petición "*" -- "0..1" Archivo : satisfaceCon >

Usuario "1\n(mentor)" -- "*" Mentoría : imparte >
Usuario "1\n(mentorado)" -- "*" Mentoría : recibe >

Mentoría "*" -- "1" Asignatura : trataSobre >
Mentoría "*" -l- "*" Archivo : utiliza >



@endluml
